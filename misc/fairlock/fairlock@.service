[Unit]
Description=Co-operative lock manager for resource %I
DefaultDependencies=no
Requires=fairlock@%i.socket
After=fairlock@%i.socket

[Service]
Type=notify
NotifyAccess=main
Restart=on-failure
RestartSec=100ms
StartLimitInterval=0
TimeoutStopSec=3
WatchdogSec=10
FileDescriptorStoreMax=128
ExecStartPre=/usr/bin/mkdir -p /run/fairlock-journal
ExecStart=/usr/libexec/fairlock /run/fairlock/%i /run/fairlock-journal/%i
